    <!-- Content Wrapper -->
    <div class="pt-6 md:pt-28 min-h-screen">
        
        <!-- TRANG CHỦ -->
        <main id="home-page">
            <!-- Hero Banner -->
            <section class="hero-banner min-h-[45vh] md:min-h-[55vh] flex items-end px-6 md:px-20 pb-12 mb-8 rounded-3xl mx-4 md:mx-10 border border-white/5 relative overflow-hidden">
                <div class="max-w-2xl z-10">
                    <div class="flex items-center gap-2 mb-3">
