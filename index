    <script>
        const API_SOURCES = {
            vsmov: {
                name: "VSMov",
                home: (page) => `https://vsmov.com/api/danh-sach/phim-moi-cap-nhat?page=${page}`,
                detail: (slug) => `https://vsmov.com/api/phim/${slug}`,
                search: (kw) => `https://vsmov.com/api/v1/api/tim-kiem?keyword=${encodeURIComponent(kw)}`
            },
            phimapi: {
                name: "PhimAPI",
                home: (page) => `https://phimapi.com/danh-sach/phim-moi-cap-nhat?page=${page}`,
                detail: (slug) => `https://phimapi.com/phim/${slug}`,
                search: (kw) => `https://phimapi.com/v1/api/tim-kiem?keyword=${encodeURIComponent(kw)}`
            },
            ophim: {
                name: "OPhim",
                home: (page) => `https://ophim1.com/danh-sach/phim-moi-cap-nhat?page=${page}`,
                detail: (slug) => `https://ophim1.com/phim/${slug}`,
                search: (kw) => `https://ophim1.com/v1/api/tim-kiem?keyword=${encodeURIComponent(kw)}`
            },
            kkphim: {
                name: "KKPhim",
                home: (page) => `https://phim.kkphim.com/danh-sach/phim-moi-cap-nhat?page=${page}`,
                detail: (slug) => `https://phim.kkphim.com/phim/${slug}`,
                search: (kw) => `https://phim.kkphim.com/v1/api/tim-kiem?keyword=${encodeURIComponent(kw)}`
            }
        };

        let currentSource = localStorage.getItem('selected_api_source') || 'vsmov';
        
        function updateSourceLabel() {
            const sourceName = API_SOURCES[currentSource]?.name || 'VSMov';
            document.getElementById('current-source-label').innerText = `Nguồn: ${sourceName}`;
            const mobileLbl = document.getElementById('current-source-label-mobile');
            if(mobileLbl) mobileLbl.innerText = `Nguồn: ${sourceName}`;
        }
        updateSourceLabel();

        let currentPage = 1, currentKeyword = '', movieCache = null;

        function getUrlSlug() { return new URLSearchParams(window.location.search).get('slug'); }
        function toggleSupport() { document.getElementById('support-modal').classList.toggle('hidden'); }

        function toggleFocusMode() {
            document.body.classList.toggle('focus-mode');
            const isFocus = document.body.classList.contains('focus-mode');
            document.getElementById('focus-text').innerText = isFocus ? 'Bật đèn' : 'Tắt đèn';
        }

        /* Modal chọn nguồn API */
        function openSourceModal() {
            const container = document.getElementById('source-options');
            container.innerHTML = '';

            Object.keys(API_SOURCES).forEach(key => {
                const isSelected = key === currentSource;
                const src = API_SOURCES[key];
                
                const item = document.createElement('div');
                item.onclick = () => selectApiSource(key);
                item.className = `p-4 rounded-2xl border flex items-center justify-between cursor-pointer transition ${
                    isSelected 
                        ? 'bg-red-600/10 border-red-600 text-white' 
                        : 'bg-white/5 border-white/5 text-gray-300 hover:bg-white/10 hover:border-white/10'
                }`;

                item.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-xl ${isSelected ? 'bg-red-600 text-white' : 'bg-white/5 text-gray-400'} flex items-center justify-center font-black text-xs">
                            <i class="fa-solid fa-server"></i>
                        </div>
                        <span class="font-bold text-xs md:text-sm">${src.name}</span>
                    </div>
                    ${isSelected ? '<i class="fa-solid fa-circle-check text-green-500 text-lg"></i>' : ''}
                `;
                container.appendChild(item);
            });

            document.getElementById('source-modal').classList.remove('hidden');
        }

        function closeSourceModal() {
            document.getElementById('source-modal').classList.add('hidden');
        }

        function selectApiSource(key) {
            if (currentSource === key) {
                closeSourceModal();
                return;
            }
            currentSource = key;
            localStorage.setItem('selected_api_source', currentSource);
            updateSourceLabel();
            closeSourceModal();

            currentPage = 1;
            currentKeyword = '';
            document.getElementById('search-input').value = '';
            if (window.location.search) {
                window.history.replaceState({}, '', window.location.pathname);
            }
            document.getElementById('watch-page').classList.add('hidden');
            document.getElementById('home-page').classList.remove('hidden');
            document.getElementById('grid-title').innerText = "Cập Nhật Mới Nhất";
            document.getElementById('load-more-container').style.display = 'flex';
            fetchMovies(1, false);
        }

        function toggleShare() {
            const modal = document.getElementById('share-modal');
            if(modal.classList.contains('hidden') && movieCache) {
                const m = movieCache.movie;
                document.getElementById('share-title').innerText = m.name;
                document.getElementById('share-poster').src = m.thumb_url || m.poster_url || '';
                document.getElementById('share-url').value = `${window.location.origin}${window.location.pathname}?slug=${m.slug}`;
            }
            modal.classList.toggle('hidden');
        }

        function copyShareLink() {
            const input = document.getElementById('share-url');
            input.select();
            document.execCommand('copy');
            const btn = document.getElementById('copy-btn');
            btn.innerText = "ĐÃ COPY!";
            setTimeout(() => btn.innerText = "COPY", 2000);
        }

        async function fetchMovies(page = 1, append = false) {
            const api = API_SOURCES[currentSource];
            let url = currentKeyword ? api.search(currentKeyword) : api.home(page);

            try {
                const res = await fetch(url);
                const data = await res.json();
                
                let items = data.items || data.data?.items || [];
                
                const langFilter = document.getElementById('lang-filter').value;
                let finalItems = items;
                if(langFilter) finalItems = items.filter(m => (m.lang || '').includes(langFilter));
                
                renderMovies(finalItems, append);
            } catch (e) {
                console.error("Lỗi khi tải phim:", e);
                if(!append) {
                    document.getElementById('movie-grid').innerHTML = `
                        <div class="col-span-full py-12 text-center">
                            <i class="fa-solid fa-circle-exclamation text-red-500 text-3xl mb-3"></i>
                            <p class="text-gray-400 font-bold text-sm">Không thể tải dữ liệu từ nguồn ${API_SOURCES[currentSource].name}. Vui lòng chuyển sang nguồn khác!</p>
                        </div>`;
                }
            }
        }

        function renderMovies(items, append) {
            const grid = document.getElementById('movie-grid');
            if(!append) grid.innerHTML = '';
            
            if(!items || items.length === 0) {
                if(!append) grid.innerHTML = `<p class="col-span-full text-center text-gray-500 py-12 font-bold text-sm">Không tìm thấy phim nào phù hợp.</p>`;
                return;
            }

            items.forEach(m => {
                const thumb = m.thumb_url || m.poster_url || '';
                grid.innerHTML += `
                <div class="movie-card group" onclick="watchMovie('${m.slug}')">
                    <div class="relative aspect-[2/3] rounded-2xl overflow-hidden bg-white/5 border border-white/10">
                        <div class="lang-badge absolute top-2 left-2 z-10">${m.lang || 'Vietsub'}</div>
                        <img src="${thumb}" loading="lazy" class="w-full h-full object-cover transition duration-500 group-hover:scale-105">
                        <div class="play-overlay absolute inset-0 bg-black/60 backdrop-blur-[2px] flex items-center justify-center">
                            <div class="w-12 h-12 rounded-full bg-red-600 text-white flex items-center justify-center shadow-lg shadow-red-600/50">
                                <i class="fa-solid fa-play ml-1 text-base"></i>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 px-1">
                        <h3 class="font-bold text-xs md:text-sm text-gray-200 truncate group-hover:text-red-500 transition">${m.name}</h3>
                        <p class="text-[10px] text-gray-500 mt-0.5 font-medium flex items-center gap-2">
                            <span>${m.year || '2026'}</span>
                            <span>•</span>
                            <span class="text-gray-400">${m.quality || 'HD'}</span>
                        </p>
                    </div>
                </div>`;
            });
        }

        async function watchMovie(slug, push = true) {
            try {
                const api = API_SOURCES[currentSource];
                const res = await fetch(api.detail(slug));
                const data = await res.json();
                if(!data.status && !data.movie) return;
                movieCache = data;
                
                if(push) window.history.pushState({slug}, '', `?slug=${slug}`);
                
                const m = data.movie;
                document.getElementById('m-title').innerText = m.name;
                document.getElementById('m-desc').innerHTML = m.content || m.description || 'Đang cập nhật nội dung...';
                document.getElementById('m-meta').innerHTML = `
                    <span class="bg-red-600 text-white px-3 py-1 rounded-lg text-[10px] font-black">${m.year || '2026'}</span>
                    <span class="bg-white/10 text-gray-300 px-3 py-1 rounded-lg text-[10px] font-bold border border-white/10">${m.quality || 'HD'}</span>
                    <span class="bg-white/10 text-gray-300 px-3 py-1 rounded-lg text-[10px] font-bold border border-white/10">${m.lang || 'Vietsub'}</span>
                `;

                const svList = document.getElementById('server-list'); 
                svList.innerHTML = '';
                const episodes = data.episodes || [];
                
                episodes.forEach((sv, i) => {
                    const btn = document.createElement('button');
                    btn.className = `px-4 py-2 rounded-xl text-xs font-bold bg-white/5 border border-white/10 whitespace-nowrap hover:bg-white/10 transition`;
                    btn.innerText = sv.server_name;
                    btn.onclick = () => loadEps(i);
                    if(i===0) btn.classList.add('active-ep');
                    svList.appendChild(btn);
                });

                if(episodes.length > 0) loadEps(0);

                document.getElementById('home-page').classList.add('hidden');
                document.getElementById('watch-page').classList.remove('hidden');
                window.scrollTo(0,0);
            } catch (e) {
                console.error("Lỗi xem phim:", e);
            }
        }

        function loadEps(idx) {
            const epList = document.getElementById('ep-list'); 
            epList.innerHTML = '';
            const serverData = movieCache.episodes[idx]?.server_data || [];
            
            document.getElementById('ep-count').innerText = `${serverData.length} tập`;

            serverData.forEach((ep, i) => {
                const btn = document.createElement('button');
                btn.className = `ep-btn py-2.5 rounded-xl text-xs font-extrabold`;
                btn.innerText = ep.name;
                
                if(i===0) { 
                    document.getElementById('main-player').src = ep.link_embed; 
                    btn.classList.add('active-ep'); 
                }
                
                btn.onclick = () => { 
                    document.getElementById('main-player').src = ep.link_embed; 
                    document.querySelectorAll('.ep-btn').forEach(b => b.classList.remove('active-ep'));
                    btn.classList.add('active-ep');
                };
                epList.appendChild(btn);
            });
        }

        function applyFilter() {
            currentPage = 1; 
            fetchMovies(1, false);
            document.getElementById('watch-page').classList.add('hidden');
            document.getElementById('home-page').classList.remove('hidden');
        }

        function searchMovies() {
            const kw = document.getElementById('search-input').value.trim();
            if(!kw) {
                currentKeyword = '';
                document.getElementById('grid-title').innerText = "Cập Nhật Mới Nhất";
                document.getElementById('load-more-container').style.display = 'flex';
                fetchMovies(1, false);
                return;
            }
            currentKeyword = kw;
            currentPage = 1;
            document.getElementById('grid-title').innerText = `Kết Quả: "${kw}"`;
            document.getElementById('load-more-container').style.display = 'none';
            fetchMovies(1, false);
            document.getElementById('watch-page').classList.add('hidden');
            document.getElementById('home-page').classList.remove('hidden');
        }

        window.onload = () => {
            const s = getUrlSlug();
            if(s) watchMovie(s, false); 
            else fetchMovies();
        };

        window.onpopstate = () => {
            const s = getUrlSlug();
            if(s) watchMovie(s, false); 
            else window.location.reload();
        };

        function loadNextPage() { 
            if(currentKeyword) return;
            currentPage++; 
            fetchMovies(currentPage, true); 
        }
    </script>
</body>
</html>
