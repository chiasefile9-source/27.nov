<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>27NOVVIETSUB | Trải Nghiệm Điện Ảnh Đỉnh Cao</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
        
        :root { 
            --primary: #e50914; 
            --primary-glow: rgba(229, 9, 20, 0.4);
            --bg: #070709; 
            --surface: #121217;
            --surface-border: rgba(255, 255, 255, 0.08);
        }
        
        * { 
            scrollbar-width: thin; 
            scrollbar-color: #e50914 #070709;
        }
        *::-webkit-scrollbar { width: 6px; height: 6px; }
        *::-webkit-scrollbar-track { background: var(--bg); }
        *::-webkit-scrollbar-thumb { background: #222; border-radius: 10px; }
        *::-webkit-scrollbar-thumb:hover { background: var(--primary); }

        body { 
            background-color: var(--bg); 
            color: #f3f4f6; 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            margin: 0; padding: 0; 
            overflow-x: hidden; 
        }
        
        .glass-nav {
            background: rgba(10, 10, 15, 0.75);
            backdrop-filter: blur(24px); 
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255,255,255,0.08);
        }

        .hero-banner {
            background: linear-gradient(180deg, rgba(7,7,9,0.2) 0%, rgba(7,7,9,0.95) 90%, var(--bg) 100%), 
                        url('https://images.unsplash.com/photo-1626814026160-2237a95fc5a0?auto=format&fit=crop&w=1950&q=80');
            background-size: cover; 
            background-position: center 20%;
        }

        .movie-card { 
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); 
            cursor: pointer; 
            position: relative; 
        }
        .movie-card:hover { 
            transform: translateY(-8px) scale(1.02); 
            box-shadow: 0 12px 30px rgba(0,0,0,0.8), 0 0 20px var(--primary-glow);
        }

        .movie-card:hover .play-overlay {
            opacity: 1;
            transform: scale(1);
        }
        
        .play-overlay {
            transition: all 0.3s ease;
            opacity: 0;
            transform: scale(0.8);
        }

        .lang-badge {
            padding: 4px 10px; 
            border-radius: 8px; 
            font-size: 10px; 
            font-weight: 800;
            text-transform: uppercase; 
            background: linear-gradient(135deg, #e50914 0%, #b20710 100%); 
            color: white;
            box-shadow: 0 4px 12px rgba(229, 9, 20, 0.4);
        }

        .filter-btn {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            color: #d1d5db; 
            font-size: 12px; 
            font-weight: 700;
            padding: 8px 16px; 
            border-radius: 12px; 
            transition: all 0.3s ease;
        }
        .filter-btn:hover {
            background: rgba(255,255,255,0.1);
            border-color: rgba(255,255,255,0.2);
            color: white;
        }

        .ep-btn { 
            background: rgba(255,255,255,0.04); 
            border: 1px solid rgba(255,255,255,0.08); 
            transition: all 0.25s ease; 
            cursor: pointer; 
            color: #9ca3af; 
        }
        .ep-btn:hover {
            background: rgba(255,255,255,0.1);
            color: white;
            border-color: rgba(255,255,255,0.2);
        }
        .active-ep { 
            background: var(--primary) !important; 
            border-color: var(--primary) !important; 
            color: white !important; 
            box-shadow: 0 0 15px var(--primary-glow); 
        }

        .player-glow {
            box-shadow: 0 0 50px rgba(229, 9, 20, 0.15);
        }

        .focus-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.92);
            z-index: 1500;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.4s ease;
        }
        .focus-mode .focus-overlay {
            opacity: 1;
        }
        .focus-mode #player-container {
            position: relative;
            z-index: 1600;
        }

        @keyframes pulse-glow {
            0%, 100% { opacity: 0.6; }
            50% { opacity: 1; }
        }
        .live-dot {
            animation: pulse-glow 2s infinite;
        }
    </style>
</head>
<body class="selection:bg-red-600 selection:text-white">

    <div id="focus-bg" class="focus-overlay"></div>

    <!-- Popup Chọn Nguồn Phim -->
    <div id="source-modal" class="fixed inset-0 z-[4500] hidden flex items-center justify-center p-4 bg-black/85 backdrop-blur-xl transition-all">
